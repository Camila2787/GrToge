<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            style="@style/TituloLila"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Más" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Gastos que se repiten, deudas, ahorro, metas y primas."
            android:textColor="@color/texto_suave"
            android:textSize="15sp" />

        <include
            layout="@layout/barra_chips"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp" />

        <TextView
            android:id="@+id/btnFijos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_card_click"
            android:padding="18dp"
            android:text="Gastos fijos"
            android:textColor="@color/lila_oscuro"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnDeudas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_card_click"
            android:padding="18dp"
            android:text="Deudas"
            android:textColor="@color/lila_oscuro"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnAhorro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_card_click"
            android:padding="18dp"
            android:text="Ahorro"
            android:textColor="@color/lila_oscuro"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnMetas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_card_click"
            android:padding="18dp"
            android:text="Metas"
            android:textColor="@color/lila_oscuro"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnPrimas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_card_click"
            android:padding="18dp"
            android:text="Primas"
            android:textColor="@color/lila_oscuro"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnHistorial"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_card_click"
            android:padding="18dp"
            android:text="Historial del mes"
            android:textColor="@color/lila_oscuro"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnAjustes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_chip_on"
            android:padding="18dp"
            android:text="Salarios y nombres"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>
</ScrollView>
