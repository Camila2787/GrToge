<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="8dp"
        android:paddingEnd="20dp"
        android:paddingBottom="8dp">

        <EditText
            android:id="@+id/campoNombreMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_input"
            android:hint="Nombre de la meta"
            android:importantForAutofill="no"
            android:inputType="textCapSentences"
            android:padding="14dp"
            android:textColor="@color/texto" />

        <EditText
            android:id="@+id/campoObjetivo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_input"
            android:hint="Cuánto quieres juntar"
            android:importantForAutofill="no"
            android:inputType="number"
            android:padding="14dp"
            android:textColor="@color/texto" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Plazo"
            android:textColor="@color/texto"
            android:textSize="14sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/plazoCorto"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_chip_on"
                android:gravity="center"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:text="Corto"
                android:textColor="@color/white"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/plazoMediano"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_chip_off"
                android:gravity="center"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:text="Mediano"
                android:textColor="@color/lila_oscuro"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/plazoLargo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_chip_off"
                android:gravity="center"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:text="Largo"
                android:textColor="@color/lila_oscuro"
                android:textSize="14sp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Corto: hasta un año. Mediano: de uno a tres años. Largo: más de tres años."
            android:textColor="@color/texto_suave"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/btnInicioMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card_click"
            android:padding="14dp"
            android:textColor="@color/lila_oscuro"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/btnFinMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_card_click"
            android:padding="14dp"
            android:textColor="@color/lila_oscuro"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/tvLapso"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/texto_suave"
            android:textSize="14sp" />

        <Spinner
            android:id="@+id/spinnerMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp" />
    </LinearLayout>
</ScrollView>
