<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Base.Theme.Lila" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/lila</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/lila_suave</item>
        <item name="colorOnPrimaryContainer">@color/lila_oscuro</item>
        <item name="colorSecondary">@color/lila_profundo</item>
        <item name="android:statusBarColor">@color/fondo</item>
        <item name="android:navigationBarColor">@color/tarjeta</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowBackground">@color/fondo</item>
        <item name="materialButtonStyle">@style/BotonLila</item>
    </style>

    <style name="Theme.Lila" parent="Base.Theme.Lila" />

    <style name="BotonLila" parent="Widget.Material3.Button">
        <item name="cornerRadius">28dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
    </style>

    <style name="TituloLila">
        <item name="android:textColor">@color/lila_oscuro</item>
        <item name="android:textSize">32sp</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
